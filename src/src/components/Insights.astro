---
import { getPublishedPosts, formatDate } from '@/lib/blog';

const posts = (await getPublishedPosts()).slice(0, 3);
---

{posts.length > 0 && (
  <section id="insights" class="py-24 border-b border-surface-subtle">
    <div class="w-full max-w-content mx-auto px-6">

      <h2 class="text-3xl font-semibold mb-4 text-ink-primary">Thinking</h2>
      <p class="text-ink-muted max-w-2xl mb-16">
        How we must look at things in order to progress, using the resources and technology already in reach.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="block p-8 border border-surface-subtle bg-white hover:border-brand-orange transition-colors duration-200"
          >
            <p class="text-xs text-ink-muted mb-4">{formatDate(post.data.pubDate)}</p>
            <h3 class="text-base font-semibold mb-3 text-ink-primary leading-snug">{post.data.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{post.data.description}</p>
          </a>
        ))}
      </div>

      <a href="/blog/" class="inline-block mt-12 text-sm text-brand-orange hover:underline">All thinking &rarr;</a>

    </div>
  </section>
)}
