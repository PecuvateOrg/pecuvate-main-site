---
const year = new Date().getFullYear();

// TODO: Replace with approved values from Production/01-content/footer.md
const email = 'enquiries@pecuvate.com';
import { socialLinks } from '../lib/social';
import { SITE_URL, blogUrl } from '../lib/blog';

const columns = [
  {
    heading: 'Explore',
    links: [
      { label: 'Kits', href: `${SITE_URL}/kits/` },
      { label: 'Blog', href: blogUrl() },
      { label: 'Contact', href: `mailto:${email}` },
    ],
  },
  {
    heading: 'Follow',
    links: socialLinks.map(({ label, href }) => ({ label, href, external: true })),
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: `${SITE_URL}/legal/privacy-policy` },
      { label: 'Terms', href: `${SITE_URL}/legal/terms-and-conditions` },
    ],
  },
];
---

<footer class="border-t border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6 pt-16 pb-8">

    <div class="grid gap-12 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href={SITE_URL} class="inline-flex min-h-[44px] items-center gap-3 text-ink-primary">
          <img src="/logo.png" alt="" width="32" height="32" />
          <span class="font-semibold">Pecuvate</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-ink-muted leading-relaxed">
          Building Systems That Generate Enduring Value
        </p>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-3 gap-6 md:contents">
        {columns.map(({ heading, links }) => (
          <nav aria-label={heading}>
            <h2 class="text-xs font-medium uppercase tracking-wider text-ink-primary">{heading}</h2>
            <ul class="mt-2">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...('external' in link ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="inline-flex min-h-[44px] items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-surface-subtle text-xs text-ink-muted">
      <p>&copy; {year} Pecuvate. All rights reserved.</p>
    </div>

  </div>
</footer>
