---
const year = new Date().getFullYear();

// TODO: Replace with approved values from Production/01-content/footer.md
const email = 'enquiries@pecuvate.com';
import { socialLinks } from '../lib/social';
---

<footer class="py-12 border-t border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">

    <!-- Copyright -->
    <p class="text-sm text-ink-muted">
      &copy; {year} Pecuvate. All rights reserved.
    </p>

    <!-- Footer Links -->
    <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink-muted">
      <a href={`mailto:${email}`} class="hover:text-ink-primary transition-colors duration-200">
        {email}
      </a>
      {socialLinks.map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-ink-primary transition-colors duration-200">
          {label}
        </a>
      ))}
      <a href="/legal/privacy-policy" class="hover:text-ink-primary transition-colors duration-200">
        Privacy
      </a>
    </div>

  </div>
</footer>
