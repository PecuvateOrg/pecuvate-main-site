---
import { GEARS, gearUrl } from '@/lib/gears';

const projects = [
  { title: 'AI customer support that answers from your own knowledge', description: 'Replies to customers from your organisation’s own knowledge and hands over to your staff when it should.' },
  { title: 'End-to-end e-signing, run from your AI assistant', name: 'PecuSign', description: 'Your AI assistant prepares and sends the document; it comes back signed, sealed and stored.', href: gearUrl('pecusign') },
  { title: 'Bookkeeping and bank sync through your AI assistant', name: `Finance ${GEARS.singular}`, description: 'Syncs the bank and keeps the books from the AI app you already use, with your data kept on your computer.', href: gearUrl('finance') },
  { title: 'Shared inbox turned into a department to-do list', name: 'Staff Inbox', description: 'Turns shared email and platform messages into one to-do list per department. Every message has an owner, a customer’s reply reopens the task, and nothing waits on one person’s inbox.' },
  { title: 'Booking, membership and payments in one platform', description: 'Sessions, memberships, payments, refunds and waivers in one place instead of five separate tools.' },
  { title: 'Freelancer hiring to payroll, as one workflow', description: 'Applications, contracts, shifts and payroll as one connected flow, not a week of manual coordination.' },
];
---

<section id="built" class="py-16 md:py-24 border-b border-surface-subtle bg-white">
  <div class="w-full max-w-content mx-auto px-6">

    <p class="text-xs font-medium uppercase tracking-wider text-brand-orange-text mb-3 text-center">What we’ve built</p>
    <h2 class="text-3xl font-semibold mb-4 text-ink-primary text-center">Tools we’ve built, in use every day</h2>
    <p class="text-ink-muted max-w-2xl mx-auto text-center mb-12 leading-relaxed">Each one runs in a real organisation today. Several started inside Empowr CIC, a community interest company in our own group.</p>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {projects.map((p) => (
        <div class="flex flex-col p-8 border border-surface-subtle">
          <h3 class="text-lg font-semibold text-ink-primary">{p.title}</h3>
          {p.name && <p class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-muted">{p.name}</p>}
          <p class="mt-3 text-ink-muted text-sm leading-relaxed">{p.description}</p>
          {p.href && <a href={p.href} class="mt-auto pt-4 inline-flex min-h-[44px] items-center text-sm text-brand-orange-text hover:underline">View more &rarr;</a>}
        </div>
      ))}
    </div>

  </div>
</section>
