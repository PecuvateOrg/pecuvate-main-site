---
const projects = [
  {
    client: 'Empowr CIC',
    tag: 'Donation Platform',
    title: 'Empowr Heroes',
    description: 'A purpose-built donation platform for a UK community interest organisation. Replaced a fee-heavy third-party solution with a direct Stripe integration, automated donor communications via Resend, and a campaign management system — giving the organisation full control over its fundraising infrastructure.',
    stack: ['Next.js', 'Stripe', 'Resend', 'Netlify'],
  },
  {
    client: 'Empowr CIC',
    tag: 'Operational Automation',
    title: 'Freelancer Network',
    description: 'End-to-end automation of the freelancer lifecycle — from application and onboarding to contract signing, shift management, payroll processing, and compliance. What previously required a week of manual coordination now runs as a single connected flow, without human intervention at each step.',
    stack: ['Notion', 'Dropbox Sign', 'Xero', 'Starling'],
  },
];
---

<section id="work" class="py-24 border-b border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6">

    <h2 class="text-3xl font-semibold mb-4 text-ink-primary">Work</h2>
    <p class="text-ink-muted max-w-2xl mb-4 leading-relaxed">Diagnose the constraint, then design across revenue, capacity, and positioning at once — a selection of systems built and deployed.</p>
    <p class="text-sm text-brand-orange font-medium mb-16">Empowr CIC is a venture within our own group — six connected platforms, automated payments, e-signature, and payroll, delivered March–June 2026. We build on the same system we offer.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <div class="p-10 border border-surface-subtle bg-white flex flex-col gap-6">

          <div>
            <p class="text-xs font-medium text-brand-orange uppercase tracking-widest mb-1">{project.client} — {project.tag}</p>
            <h3 class="text-xl font-semibold text-ink-primary">{project.title}</h3>
          </div>

          <p class="text-sm text-ink-muted leading-relaxed flex-1">{project.description}</p>

          <div class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="text-xs px-3 py-1 border border-surface-subtle text-ink-muted">{tech}</span>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
