---
import { GEARS, gearUrl } from '@/lib/gears';

const projects = [
  { tag: 'Empowr CIC', title: 'Members and bookings', description: 'One platform for booking sessions, memberships, payments, refunds and waivers, replacing a set of separate tools.' },
  { tag: 'Empowr CIC', title: 'Freelancer network', description: 'Applications, contracts, shifts and payroll run as one connected flow instead of a week of manual coordination.' },
  { tag: 'Pecuvate', title: 'AI customer support', description: 'A chat assistant that answers from the organisation’s own knowledge and hands over to staff when it should.' },
  { tag: 'Product', title: `Finance ${GEARS.singular}`, description: 'Syncs the bank and keeps the books through your own AI app, with everything stored on your computer.', href: gearUrl('finance') },
];
---

<section id="built" class="py-16 md:py-24 border-b border-surface-subtle bg-white">
  <div class="w-full max-w-content mx-auto px-6">

    <p class="text-xs font-medium uppercase tracking-wider text-brand-orange-text mb-3 text-center">What we’ve built</p>
    <h2 class="text-3xl font-semibold mb-4 text-ink-primary text-center">Built, running and in daily use</h2>
    <p class="text-ink-muted max-w-2xl mx-auto text-center mb-12 leading-relaxed">Empowr CIC is a community interest company in our own group. Its platforms run on the same approach we offer.</p>

    <div class="grid gap-6 md:grid-cols-2 max-w-5xl mx-auto">
      {projects.map((p) => (
        <div class="p-8 border border-surface-subtle">
          <p class="text-xs font-medium uppercase tracking-wider text-ink-muted mb-2">{p.tag}</p>
          <h3 class="text-lg font-semibold mb-2 text-ink-primary">{p.title}</h3>
          <p class="text-ink-muted text-sm leading-relaxed">{p.description}</p>
          {p.href && <a href={p.href} class="mt-4 inline-flex min-h-[44px] items-center text-sm text-brand-orange-text hover:underline">Learn more &rarr;</a>}
        </div>
      ))}
    </div>

  </div>
</section>
