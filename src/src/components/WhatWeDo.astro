---
const steps = [
  { step: '01', label: 'Discover', description: 'We start with the problem, not the tool. We work out what is really getting in the way and what a good solution has to do.' },
  { step: '02', label: 'Build', description: 'We invent the solution and build it, choosing the right resource for each part: software, automation, AI, or a better process.' },
  { step: '03', label: 'Apply', description: 'We put it to work in your day-to-day, so it keeps doing its job long after launch.' },
];
---

<section id="what-we-do" class="py-16 md:py-24 border-b border-surface-subtle bg-white">
  <div class="w-full max-w-content mx-auto px-6">

    <p class="text-xs font-medium uppercase tracking-wider text-brand-orange-text mb-3 text-center">What we do</p>
    <h2 class="text-3xl font-semibold text-ink-primary text-balance text-center max-w-2xl mx-auto mb-10 md:mb-16">The right solution for the task. The right resource for the solution.</h2>

    <ol class="grid gap-8 md:gap-12 md:grid-cols-3 max-w-5xl mx-auto">
      {steps.map((s) => (
        <li class="text-center border-t border-surface-subtle pt-6 md:pt-8">
          <span class="block text-sm font-medium text-brand-orange-text mb-3">{s.step}</span>
          <h3 class="text-xl font-semibold mb-2 text-ink-primary">{s.label}</h3>
          <p class="text-ink-muted leading-relaxed">{s.description}</p>
        </li>
      ))}
    </ol>

  </div>
</section>
