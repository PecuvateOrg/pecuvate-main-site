---
const pillars = [
  {
    label: 'Consulting',
    description: 'We diagnose the root cause of what isn’t working inside an existing organisation, then architect the business model or system redesign required. The output is not a recommendation deck — it is a rebuilt model.',
  },
  {
    label: 'Venture Co-creation',
    description: 'We partner from inception, with equity, to build ventures with enduring systems designed in from day one — not bolted on after the fact.',
  },
  {
    label: 'Product Development',
    description: 'What works across consulting and venture work gets systematised into scalable tools — serving the portfolio first, then the wider market.',
  },
];
---

<section id="what-we-do" class="py-24 border-b border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6">

    <h2 class="text-3xl font-semibold mb-4 text-ink-primary">How we work</h2>
    <p class="text-ink-muted max-w-2xl mb-16 leading-relaxed">One method — architect the model, then build what runs it — applied through three vehicles, depending on what a given problem requires.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((pillar) => (
        <div class="p-8 border border-surface-subtle bg-white">
          <h3 class="text-lg font-semibold mb-3 text-ink-primary">{pillar.label}</h3>
          <p class="text-ink-muted text-sm leading-relaxed">{pillar.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
