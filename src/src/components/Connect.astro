---
import { linkedin } from '../lib/social';
---

<section id="connect" class="py-16 md:py-24 bg-white border-b border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6">

    <h2 class="text-3xl font-semibold mb-4 text-ink-primary text-center">Work with Pecuvate</h2>
    <p class="text-ink-muted max-w-2xl mx-auto text-center mb-16 leading-relaxed">Have a problem worth solving? Tell us about it.</p>

    <div class="flex flex-col items-center sm:flex-row sm:justify-center gap-4 sm:gap-6">

      <a
        href="/contact/"
        class="inline-flex w-60 sm:w-auto justify-center items-center gap-3 px-8 py-4 border border-ink-primary text-ink-primary font-medium hover:bg-ink-primary hover:text-white transition-colors duration-200"
      >
        Get in touch
      </a>

      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-60 sm:w-auto justify-center items-center gap-3 px-8 py-4 border border-brand-orange text-brand-orange-text font-medium hover:bg-brand-orange hover:text-white transition-colors duration-200"
      >
        Connect on LinkedIn
      </a>

    </div>

  </div>
</section>
