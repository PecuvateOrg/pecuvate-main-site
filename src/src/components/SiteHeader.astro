---
import { SITE_URL, blogUrl } from '@/lib/blog';
import { GEARS, gearsUrl } from '@/lib/gears';
// Site-wide header — logo + nav on the homepage, blog and gears pages.
const onAbout = Astro.url.pathname.startsWith('/about');
const onGears = Astro.url.pathname.startsWith(gearsUrl());
---

<header class="sticky top-0 z-40 border-b border-surface-subtle bg-surface/95 backdrop-blur">
  <div class="w-full max-w-content mx-auto px-4 sm:px-6 py-1.5 sm:py-4 flex items-center justify-between gap-2">
    <a href={SITE_URL} class="flex shrink-0 min-h-[44px] items-center gap-2 sm:gap-3 text-ink-primary">
      <img src="/logo.png" alt="" width="32" height="32" />
      <span class="font-semibold">Pecuvate</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-4">
      <a href={`${SITE_URL}/about/`} aria-current={onAbout ? 'page' : undefined} class="inline-flex min-h-[44px] min-w-[44px] px-2 justify-center items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">About</a>
      <a href={`${SITE_URL}${gearsUrl()}`} aria-current={onGears ? 'page' : undefined} class="inline-flex min-h-[44px] min-w-[44px] px-2 justify-center items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">{GEARS.plural}</a>
      <a href={blogUrl()} class="max-[359px]:hidden inline-flex min-h-[44px] min-w-[44px] px-2 justify-center items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">Blog</a>
      {/* Hidden until Pecuvate ID Phase 2 (customer home) ships — owner 2026-11-13. Restore by removing this comment wrapper. */}
      {/* <a href="https://account.pecuvate.com/sign-in" class="inline-flex min-h-[44px] min-w-[44px] px-2 justify-center items-center text-sm font-medium text-ink-primary hover:text-brand-orange-text transition-colors duration-200">Sign in</a> */}
    </nav>
  </div>
</header>
