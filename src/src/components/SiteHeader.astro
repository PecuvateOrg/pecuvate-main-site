---
import { SITE_URL, blogUrl } from '@/lib/blog';
import { GEARS, gearsUrl } from '@/lib/gears';
// Site-wide header — logo + nav on the homepage, blog and gears pages.
const onAbout = Astro.url.pathname.startsWith('/about');
const onGears = Astro.url.pathname.startsWith(gearsUrl());
---

<header class="border-b border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6 py-5 flex items-center justify-between">
    <a href={SITE_URL} class="flex min-h-[44px] items-center gap-3 text-ink-primary">
      <img src="/logo.png" alt="" width="32" height="32" />
      <span class="font-semibold">Pecuvate</span>
    </a>
    <nav class="flex items-center gap-6">
      <a href={`${SITE_URL}/about/`} aria-current={onAbout ? 'page' : undefined} class="inline-flex min-h-[44px] items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">About</a>
      <a href={`${SITE_URL}${gearsUrl()}`} aria-current={onGears ? 'page' : undefined} class="inline-flex min-h-[44px] min-w-[44px] justify-center items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">{GEARS.plural}</a>
      <a href={blogUrl()} class="inline-flex min-h-[44px] items-center text-sm text-ink-muted hover:text-ink-primary transition-colors duration-200">Blog</a>
    </nav>
  </div>
</header>
