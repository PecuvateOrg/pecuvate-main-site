---
const entities = [
  {
    name: 'Pecuvate',
    role: 'The operating system — identifies, tests, builds, and scales the ventures that run on it.',
  },
  {
    name: 'Zenium',
    role: 'Media production and marketing — content systems and the knowledge extraction pattern that feeds back into the OS.',
  },
  {
    name: 'Resorz',
    role: 'Commerce — wellness products built on a Shopify, FBA, and supply-chain architecture.',
  },
];
---

<section id="ecosystem" class="py-24 bg-white border-b border-surface-subtle">
  <div class="w-full max-w-content mx-auto px-6">

    <!-- Section Heading -->
    <h2 class="text-3xl font-semibold mb-4 text-ink-primary">One system, three engines</h2>

    <!-- Section Intro -->
    <p class="text-ink-muted max-w-2xl mb-16">Internally, Pecuvate is the operating system of BFG Alliance — the system that identifies, tests, builds, and scales the ventures that run on it. Zenium and Resorz are two of those ventures — proof the same methodology holds across sectors, not one studio doing three unrelated things.</p>

    <!-- Three Entities -->
    <!-- Layout shows relationship, not hierarchy — see Production/01-content/ecosystem.md for the deferred circular/node treatment -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {entities.map((entity) => (
        <div class="p-8 border border-surface-subtle">
          <h3 class="text-lg font-semibold mb-3 text-brand-orange">{entity.name}</h3>
          <p class="text-ink-muted text-sm leading-relaxed">{entity.role}</p>
        </div>
      ))}
    </div>

  </div>
</section>
