---
import '../styles/global.css';
import { blogUrl } from '../lib/blog';
import { ClientRouter } from 'astro:transitions';

// Page transition = Web Build Framework motion Level 1 (fade + rise 20px, 0.5s).
const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
const pageTransition = {
  forwards: {
    old: { name: 'pvPageOut', duration: '0.2s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'pvPageIn', duration: '0.5s', easing: ease, fillMode: 'both' },
  },
  backwards: {
    old: { name: 'pvPageOut', duration: '0.2s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'pvPageIn', duration: '0.5s', easing: ease, fillMode: 'both' },
  },
};

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  // Blog pages pass their blog.pecuvate.com URL; other pages derive it from the path.
  canonical?: string;
}

const {
  title = 'Pecuvate — Solutions Built to Endure',
  ogType = 'website',
  description = 'Pecuvate invents solutions tailored to your needs: we help you discover, build and apply the right technological solution.',
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Pecuvate — Thinking" href={blogUrl('rss.xml')} />

    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Plus Jakarta Sans from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      // Smooth scrolling is for in-page links only. On a page change the router jumps to the
      // top; with smooth scrolling on, that jump was animated from the bottom of the old page.
      document.addEventListener('astro:before-preparation', function () {
        document.documentElement.style.scrollBehavior = 'auto';
      });
      document.addEventListener('astro:before-swap', function (e) {
        e.newDocument.documentElement.style.scrollBehavior = 'auto';
      });
      document.addEventListener('astro:page-load', function () {
        requestAnimationFrame(function () { document.documentElement.style.scrollBehavior = ''; });
      });
    </script>
  </head>
  <body class="bg-surface text-ink-primary font-sans antialiased" transition:animate={pageTransition}>
    <slot />
  </body>
</html>
