---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Footer from '@/components/Footer.astro';
import { GEARS, gears, gearHelpUrl } from '@/lib/gears';

export async function getStaticPaths() {
  const all = await getCollection('gearHelp');
  return all.flatMap((entry) => {
    const [slug, article] = entry.id.split('/');
    const gear = gears.find((g) => g.slug === slug);
    return gear ? [{ params: { slug, article }, props: { entry, gear } }] : [];
  });
}

const { entry, gear } = Astro.props;
const { Content } = await render(entry);
const gearTitle = `${gear.name} ${GEARS.singular}`;
---

<BaseLayout title={`${entry.data.title} — ${gearTitle} — Pecuvate`} description={entry.data.description}>
  <SiteHeader />
  <main class="py-20">
    <article class="w-full max-w-3xl mx-auto px-6">
      <a href={gearHelpUrl(gear.slug)} class="inline-flex min-h-[44px] items-center text-sm text-ink-muted hover:text-ink-primary mb-6">← Help: {gearTitle}</a>
      <h1 class="text-4xl font-semibold leading-tight text-ink-primary mb-12">{entry.data.title}</h1>
      <div class="prose prose-neutral max-w-none prose-headings:font-semibold prose-a:text-brand-orange-text">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
