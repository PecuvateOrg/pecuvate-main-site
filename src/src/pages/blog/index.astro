---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogHeader from '@/components/BlogHeader.astro';
import PillarNav from '@/components/PillarNav.astro';
import PostList from '@/components/PostList.astro';
import Footer from '@/components/Footer.astro';
import { getPublishedPosts, blogUrl } from '@/lib/blog';

const posts = await getPublishedPosts();
const used = new Set(posts.flatMap((p) => p.data.pillars));
---

<BaseLayout
  title="Thinking — Pecuvate"
  description="Essays on rethinking how problems get solved, and on the intelligent application of technology to solve them."
  canonical={blogUrl()}
>
  <BlogHeader />
  <main class="py-24">
    <div class="w-full max-w-content mx-auto px-6">
      <h1 class="text-4xl font-semibold mb-4 text-ink-primary">Thinking</h1>
      <p class="text-ink-muted max-w-2xl mb-10">
        How we must look at things in order to progress, using the resources and technology already in reach.
      </p>
      <PillarNav used={used} />
      <PostList posts={posts} />
    </div>
  </main>
  <Footer />
</BaseLayout>
